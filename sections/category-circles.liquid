<div class="sellzay-categories">
  <div class="sellzay-categories__inner container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="sellzay-categories__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="sellzay-categories__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="sellzay-categories__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sellzay-categories__list">
      {%- assign valid_count = 0 -%}
      {%- assign max_count = section.settings.category_limit -%}

      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.enable and valid_count < max_count -%}
            {%- liquid
              assign collection = block.settings.collection
              assign title = block.settings.custom_title
              if title == blank and collection != blank
                assign title = collection.title
              endif
              
              assign image = block.settings.custom_image
              if image == blank and collection != blank
                if collection.image != blank
                  assign image = collection.image
                elsif collection.products.first != blank
                  assign image = collection.products.first.featured_image
                endif
              endif
            -%}
            
            {%- if image != blank and title != blank -%}
              {%- assign valid_count = valid_count | plus: 1 -%}
              <a href="{{ collection.url | default: '#' }}" class="sellzay-categories__item" {{ block.shopify_attributes }}>
                <div class="sellzay-categories__image-wrapper">
                  {{ image | image_url: width: 240 | image_tag: class: 'sellzay-categories__image', loading: 'lazy', alt: title }}
                </div>
                <div class="sellzay-categories__title">{{ title }}</div>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for collection in collections -%}
          {%- if collection.handle != 'frontpage' and collection.handle != 'all' and valid_count < max_count -%}
            {%- liquid
              assign title = collection.title
              assign image = blank
              if collection.image != blank
                assign image = collection.image
              elsif collection.products.first != blank
                assign image = collection.products.first.featured_image
              endif
            -%}
            
            {%- if image != blank and title != blank -%}
              {%- assign valid_count = valid_count | plus: 1 -%}
              <a href="{{ collection.url }}" class="sellzay-categories__item">
                <div class="sellzay-categories__image-wrapper">
                  {{ image | image_url: width: 240 | image_tag: class: 'sellzay-categories__image', loading: 'lazy', alt: title }}
                </div>
                <div class="sellzay-categories__title">{{ title }}</div>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if section.settings.show_view_all -%}
        <a href="{{ routes.collections_url }}" class="sellzay-categories__item sellzay-categories__view-all">
          <div class="sellzay-categories__view-all-circle">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </div>
          <div class="sellzay-categories__title">View All<br>Categories</div>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category Circles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Explore our most popular categories"
    },
    {
      "type": "range",
      "id": "category_limit",
      "label": "Number of categories to display",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 7
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Categories",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable",
          "label": "Enable",
          "default": true
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image",
          "info": "Leave blank to use collection image or first product image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Circles"
    }
  ]
}
{% endschema %}
