<header class="sellzay-header" role="banner">
  <div class="container">
    <div class="sellzay-header__inner">
      
      <!-- LOGO -->
      <div class="sellzay-header__logo">
        <a href="{{ routes.root_url }}" class="sellzay-header__logo-link">
          {%- if section.settings.logo != blank -%}
            {%- assign logo_width = section.settings.logo_width | default: 150 -%}
            {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
            {{ section.settings.logo | image_url: width: logo_width | image_tag: width: logo_width, alt: logo_alt }}
          {%- else -%}
            <span class="sellzay-header__logo-text">SELLZAY</span>
            <span class="sellzay-header__logo-tagline">SHOP SMARTER. LIVE BETTER.</span>
          {%- endif -%}
        </a>
      </div>

      <!-- SEARCH -->
      <div class="sellzay-header__search">
        <form action="{{ routes.search_url }}" method="get" class="sellzay-header__search-form" role="search">
          <input type="text" 
                 name="q" 
                 class="sellzay-header__search-input" 
                 placeholder="{{ section.settings.search_placeholder | escape }}"
                 aria-label="Search">
          <button type="submit" class="sellzay-header__search-button" aria-label="Submit search">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-search" viewBox="0 0 24 24" width="20" height="20">
              <path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"></path>
            </svg>
          </button>
        </form>
      </div>

      <!-- ACTIONS -->
      <div class="sellzay-header__actions">
        {%- if section.settings.show_account -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="sellzay-header__action" aria-label="Account">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-account" viewBox="0 0 24 24" width="24" height="24">
              <path fill="currentColor" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
            </svg>
            <span class="sellzay-header__action-text">Account</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_wishlist -%}
          <div class="sellzay-header__action" data-sellzay-wishlist>
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-heart" viewBox="0 0 24 24" width="24" height="24">
              <path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
            </svg>
            <span class="sellzay-header__action-text">Wishlist</span>
          </div>
        {%- endif -%}

        {%- if section.settings.show_cart -%}
          <a href="{{ routes.cart_url }}" class="sellzay-header__action sellzay-header__action--cart" aria-label="Cart">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-cart" viewBox="0 0 24 24" width="24" height="24">
              <path fill="currentColor" d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0 0 20 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"></path>
            </svg>
            <span class="sellzay-header__action-text">Cart</span>
            {%- if cart.item_count > 0 -%}
              <span class="sellzay-header__cart-count">{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Main Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 150
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search for products, brands and more..."
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Main Header"
    }
  ]
}
{% endschema %}
