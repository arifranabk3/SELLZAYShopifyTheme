{%- if section.blocks.size > 0 -%}
  <div class="sellzay-testimonials">
    <div class="sellzay-testimonials__inner container">
      
      <div class="sellzay-testimonials__header" style="text-align: {{ section.settings.alignment }};">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sellzay-testimonials__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="sellzay-testimonials__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.description != blank -%}
          <p class="sellzay-testimonials__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>

      <div class="sellzay-testimonials__grid">
        {%- for block in section.blocks -%}
          <div class="sellzay-testimonials__card" {{ block.shopify_attributes }}>
            {%- if block.settings.rating > 0 -%}
              <div class="sellzay-testimonials__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..block.settings.rating) -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--sellzay-orange)" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                  </svg>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if block.settings.testimonial_text != blank -%}
              <blockquote class="sellzay-testimonials__text">
                "{{ block.settings.testimonial_text }}"
              </blockquote>
            {%- endif -%}

            <div class="sellzay-testimonials__customer">
              {%- if block.settings.customer_image != blank -%}
                <div class="sellzay-testimonials__avatar">
                  {%- assign customer_alt = block.settings.customer_name | escape -%}
                  {{ block.settings.customer_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: customer_alt }}
                </div>
              {%- endif -%}

              <div class="sellzay-testimonials__customer-info">
                {%- if block.settings.customer_name != blank -%}
                  <span class="sellzay-testimonials__customer-name">{{ block.settings.customer_name }}</span>
                {%- endif -%}

                {%- if block.settings.show_verified and block.settings.verified_label != blank -%}
                  <span class="sellzay-testimonials__verified">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--sellzay-orange);"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    {{ block.settings.verified_label }}
                  </span>
                {%- endif -%}
                
                {%- if block.settings.role != blank or block.settings.location != blank -%}
                  <span class="sellzay-testimonials__customer-meta">
                    {{ block.settings.role }}{%- if block.settings.role != blank and block.settings.location != blank -%}, {% endif -%}{{ block.settings.location }}
                  </span>
                {%- endif -%}
              </div>
            </div>

          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "WHAT OUR CUSTOMERS SAY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real People. Real Experiences."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Customer Name"
        },
        {
          "type": "textarea",
          "id": "testimonial_text",
          "label": "Testimonial text",
          "default": "Please configure this block with a real customer testimonial."
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 0,
          "info": "Set to 0 to hide rating stars"
        },
        {
          "type": "image_picker",
          "id": "customer_image",
          "label": "Customer image"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Title"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show verified label",
          "default": false
        },
        {
          "type": "text",
          "id": "verified_label",
          "label": "Verified label text",
          "default": "Verified Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
