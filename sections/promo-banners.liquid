<div class="sellzay-promos">
  <div class="sellzay-promos__inner container">
    <div class="sellzay-promos__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.enable -%}
          {%- liquid
            assign target_url = block.settings.button_url
            if target_url == blank and block.settings.collection != blank
              assign target_url = block.settings.collection.url
            endif
          -%}
          <div class="sellzay-promos__card" {{ block.shopify_attributes }}>
            <div class="sellzay-promos__media">
              {%- if block.settings.image != blank -%}
                {%- assign promo_alt = block.settings.image.alt | escape -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: class: 'sellzay-promos__image', loading: 'lazy', alt: promo_alt }}
                <div class="sellzay-promos__overlay" aria-hidden="true"></div>
              {%- else -%}
                {%- assign fallback_product = collections.all.products[forloop.index0] | default: collections.all.products.first -%}
                {%- if fallback_product and fallback_product.featured_image -%}
                  {%- assign promo_alt = fallback_product.title | escape -%}
                  {{ fallback_product.featured_image | image_url: width: 800 | image_tag: class: 'sellzay-promos__image', loading: 'lazy', alt: promo_alt }}
                  <div class="sellzay-promos__overlay" aria-hidden="true"></div>
                {%- else -%}
                  <div class="sellzay-promos__fallback-bg"></div>
                {%- endif -%}
              {%- endif -%}
            </div>
            
            <div class="sellzay-promos__content">
              {%- if block.settings.badge != blank -%}
                <span class="sellzay-promos__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
              
              {%- if block.settings.heading != blank -%}
                <h3 class="sellzay-promos__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              
              {%- if block.settings.description != blank -%}
                <p class="sellzay-promos__description">{{ block.settings.description }}</p>
              {%- endif -%}
              
              {%- if block.settings.button_label != blank -%}
                <a href="{{ target_url | default: '#' }}" class="sellzay-promos__button">
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo Banners",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo Block",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable",
          "label": "Enable block",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Promo Heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Add a short promotional description here."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "e.g., NEW, TRENDING, DEAL"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now →"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL",
          "info": "Overrides Collection link if set"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection link",
          "info": "Used as the link if Button URL is empty"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Banners",
      "blocks": [
        {
          "type": "promo",
          "settings": {
            "heading": "Smart Watches",
            "description": "For a Smarter You"
          }
        },
        {
          "type": "promo",
          "settings": {
            "heading": "Beauty Essentials",
            "description": "Glow Every Day"
          }
        },
        {
          "type": "promo",
          "settings": {
            "heading": "Home & Kitchen",
            "description": "Make Life Easier"
          }
        }
      ]
    }
  ]
}
{% endschema %}
