<footer class="sellzay-footer">
  <div class="sellzay-footer__inner container">
    <div class="sellzay-footer__grid">
      
      <div class="sellzay-footer__brand">
        <a href="{{ routes.root_url }}" class="sellzay-footer__logo">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name }}
          {%- else -%}
            <span class="sellzay-footer__logo-text">SELLZEO</span>
          {%- endif -%}
        </a>
        <div class="sellzay-footer__tagline">SHOP SMARTER. LIVE BETTER.</div>
        
        {%- if section.settings.brand_description != blank -%}
          <p class="sellzay-footer__description">{{ section.settings.brand_description }}</p>
        {%- endif -%}

        <div class="sellzay-footer__social">
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="sellzay-footer__social-link" aria-label="Facebook">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="sellzay-footer__social-link" aria-label="Instagram">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm3.98-10.395a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" class="sellzay-footer__social-link" aria-label="TikTok">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.12-3.44-3.13-3.92-5.46-.53-2.58.15-5.27 1.83-7.23 1.34-1.57 3.28-2.6 5.37-2.83.18-.01.35-.01.53-.02V7.4c-1.3.1-2.59.51-3.66 1.25-1.51 1.05-2.42 2.77-2.55 4.6-.08 1.09.2 2.19.78 3.11 1.01 1.63 2.96 2.5 4.88 2.25 1.51-.2 2.74-1.22 3.32-2.62.24-.59.34-1.23.33-1.87.01-4.71 0-9.42 0-14.1z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}" class="sellzay-footer__social-link" aria-label="YouTube">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.188 0 12 0 12s0 3.812.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.812 24 12 24 12s0-3.812-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_pinterest != blank -%}
            <a href="{{ section.settings.social_pinterest }}" class="sellzay-footer__social-link" aria-label="Pinterest">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.367 18.625 0 12.017 0z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_twitter != blank -%}
            <a href="{{ section.settings.social_twitter }}" class="sellzay-footer__social-link" aria-label="X (Twitter)">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <div class="sellzay-footer__column">
        <h3 class="sellzay-footer__heading">Shop</h3>
        {%- assign shop_menu = section.settings.menu_shop -%}
        {%- if shop_menu != blank and linklists[shop_menu].links.size > 0 -%}
          <ul class="sellzay-footer__links">
            {%- for link in linklists[shop_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="sellzay-footer__column">
        <h3 class="sellzay-footer__heading">Help</h3>
        {%- assign help_menu = section.settings.menu_help -%}
        {%- if help_menu != blank and linklists[help_menu].links.size > 0 -%}
          <ul class="sellzay-footer__links">
            {%- for link in linklists[help_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="sellzay-footer__column">
        <h3 class="sellzay-footer__heading">Company</h3>
        {%- assign company_menu = section.settings.menu_company -%}
        {%- if company_menu != blank and linklists[company_menu].links.size > 0 -%}
          <ul class="sellzay-footer__links">
            {%- for link in linklists[company_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

    </div>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
      <div class="sellzay-footer__payment">
        <ul class="sellzay-footer__payment-list" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="sellzay-footer__payment-item">
              {{ type | payment_type_svg_tag: class: 'sellzay-footer__payment-icon' }}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="sellzay-footer__bottom">
      <div class="sellzay-footer__copyright">
        &copy; {{ 'now' | date: "%Y" }} SELLZEO. All rights reserved.
      </div>
      
      {%- if section.settings.show_policy_links -%}
        <div class="sellzay-footer__policies">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <a href="{{ policy.url }}" class="sellzay-footer__policy-link">{{ policy.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      
      {%- if section.settings.show_back_to_top -%}
        <button class="sellzay-footer__back-to-top" aria-label="Back to top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
          &uarr; Back to top
        </button>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Discover thoughtfully selected products for everyday life."
    },
    {
      "type": "link_list",
      "id": "menu_shop",
      "label": "Shop Menu"
    },
    {
      "type": "link_list",
      "id": "menu_help",
      "label": "Help Menu"
    },
    {
      "type": "link_list",
      "id": "menu_company",
      "label": "Company Menu"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "X (Twitter)"
    },
    {
      "type": "header",
      "content": "Additional options"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "label": "Show back to top button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
