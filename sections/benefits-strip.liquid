<div class="sellzay-benefits">
  <div class="sellzay-benefits__inner container">
    <div class="sellzay-benefits__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.enable -%}
          <div class="sellzay-benefits__item" {{ block.shopify_attributes }}>
            <div class="sellzay-benefits__icon">
              {%- case block.settings.icon -%}
                {%- when 'secure' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                {%- when 'shipping' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                {%- when 'returns' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10"></path><path d="M3.51 15A9 9 0 0 0 18.36 18.36L23 14"></path></svg>
                {%- when 'support' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3v4z"></path><path d="M3 19a2 2 0 0 0 2 2h1v-6H3v4z"></path></svg>
              {%- endcase -%}
            </div>
            <div class="sellzay-benefits__content">
              {%- if block.settings.heading != blank -%}
                <h4 class="sellzay-benefits__heading">{{ block.settings.heading }}</h4>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="sellzay-benefits__description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
          {%- unless forloop.last -%}
            <div class="sellzay-benefits__divider"></div>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Benefits Strip",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Block",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable",
          "label": "Enable block",
          "default": true
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "secure", "label": "Secure Payments" },
            { "value": "shipping", "label": "Fast Shipping" },
            { "value": "returns", "label": "Easy Returns" },
            { "value": "support", "label": "Dedicated Support" }
          ],
          "default": "secure"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Benefit Heading"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Short supporting text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Strip",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "secure",
            "heading": "100% Secure Payments",
            "description": "Shop with confidence"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shipping",
            "heading": "Fast & Reliable Shipping",
            "description": "Across the USA"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "returns",
            "heading": "Easy Returns",
            "description": "Within 30 Days"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "heading": "Dedicated Support",
            "description": "We're here to help"
          }
        }
      ]
    }
  ]
}
{% endschema %}
