{%- assign target_collection = section.settings.collection -%}
{%- if target_collection == blank or target_collection.products_count == 0 -%}
  {%- assign target_collection = collections['all'] -%}
{%- endif -%}

{%- assign products_to_show = section.settings.product_count -%}
{%- assign grid_products = target_collection.products -%}

{%- if grid_products.size > 0 -%}
  <div class="sellzay-new-arrivals">
    <div class="sellzay-new-arrivals__inner container">
      <div class="sellzay-new-arrivals__content">
        {%- if section.settings.featured_image != blank -%}
          <div class="sellzay-new-arrivals__featured-image">
            {%- assign fallback_alt = section.settings.featured_image.alt | default: section.settings.heading | escape -%}
            {{ section.settings.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: fallback_alt }}
          </div>
        {%- endif -%}
        
        <div class="sellzay-new-arrivals__text-block">
          {%- if section.settings.eyebrow != blank -%}
            <span class="sellzay-new-arrivals__eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          
          <h2 class="sellzay-new-arrivals__title">{{ section.settings.heading }}</h2>
          
          {%- if section.settings.description != blank -%}
            <p class="sellzay-new-arrivals__description">{{ section.settings.description }}</p>
          {%- endif -%}
          
          <a href="{{ section.settings.cta_url | default: target_collection.url }}" class="sellzay-btn sellzay-btn--primary sellzay-new-arrivals__cta">
            {{ section.settings.cta_text }} &rarr;
          </a>
        </div>
      </div>
      
      <div class="sellzay-new-arrivals__products">
        {%- for product in grid_products limit: products_to_show -%}
          <div class="sellzay-new-arrivals__product-item">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "New Arrivals",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "JUST DROPPED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover the latest products added to SellZeo."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "New Arrivals Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL",
      "info": "Defaults to collection URL if left blank"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Image",
      "info": "Optional editorial lifestyle image."
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
